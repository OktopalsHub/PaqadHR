{
  "name": "paqad",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo build",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "check:unsafe": "biome check --write --unsafe .",
    "dev": "turbo dev",
    "format": "biome check --write .",
    "lint": "biome check .",
    "start": "turbo start",
    "test": "turbo test",
    "deploy": "pnpm --filter web deploy",
    "cf-deploy": "pnpm --filter web cf-deploy",
    "cf-typegen": "pnpm --filter web cf-typegen"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "turbo": "^2.9.16"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2"
    ],
    "overrides": {
      "flatted": ">=3.4.2",
      "tar": ">=7.5.16",
      "postcss": ">=8.5.15",
      "picomatch": ">=4.0.4",
      "js-yaml": ">=4.3.0 <5",
      "axios": ">=1.18.0 <2",
      "form-data": ">=4.0.6 <5",
      "undici": ">=7.28.0 <8",
      "ws": ">=8.21.0 <9",
      "multer": ">=2.2.0 <3",
      "piscina": ">=4.9.3 <5",
      "body-parser": ">=2.3.0 <3",
      "brace-expansion@1": ">=1.1.16 <2",
      "brace-expansion@2": ">=2.1.2 <3",
      "brace-expansion@5": ">=5.0.7 <6",
      "cookie@<0.7.0": ">=0.7.0 <1",
      "esbuild@>=0.27.0 <0.28.1": ">=0.28.1 <0.29.0"
    }
  },
  "dependencies": {
    "zeptomail": "^8.0.1"
  }
}
