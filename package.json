{
  "name": "paqad",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "check": "oxfmt --check . && biome lint .",
    "check:fix": "oxfmt . && biome lint --write .",
    "check:unsafe": "biome lint --write --unsafe .",
    "check:patches": "node .github/scripts/check-braces-patch.mjs",
    "dev": "turbo dev",
    "format": "oxfmt .",
    "lint": "biome lint .",
    "start": "turbo start",
    "test": "turbo test",
    "deploy": "pnpm --filter web deploy",
    "cf-deploy": "pnpm --filter web cf-deploy",
    "cf-typegen": "pnpm --filter web cf-typegen",
    "infra:up": "docker compose up -d --wait db",
    "infra:down": "docker compose down",
    "infra:status": "docker compose ps",
    "infra:logs": "docker compose logs -f db",
    "infra:reset": "docker compose down -v && docker compose up -d --wait db",
    "db:up": "pnpm infra:up",
    "db:status": "pnpm infra:status",
    "db:logs": "pnpm infra:logs",
    "db:down": "pnpm infra:down"
  },
  "dependencies": {
    "zeptomail": "^8.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "oxfmt": "^0.79.0",
    "turbo": "^2.11.12"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0"
}
