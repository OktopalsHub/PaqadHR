{
  "name": "paqad",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo build",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "check:unsafe": "biome check --write --unsafe .",
    "dev": "turbo dev",
    "format": "biome check --write .",
    "lint": "biome check .",
    "start": "turbo start",
    "test": "turbo test",
    "deploy": "pnpm --filter web deploy",
    "cf-deploy": "pnpm --filter web cf-deploy",
    "cf-typegen": "pnpm --filter web cf-typegen"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "turbo": "^2.9.16"
  },
  "dependencies": {
    "zeptomail": "^8.0.1"
  }
}
