{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "description": "",
  "license": "UNLICENSED",
  "author": "",
  "scripts": {
    "build": "nest build",
    "format": "oxfmt ./src ./test",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "biome lint ./src ./test",
    "check": "oxfmt --check ./src ./test && biome lint ./src ./test",
    "check:body-dtos": "node ../../.github/scripts/check-body-dto-imports.mjs",
    "check:dto-load": "node ../../.github/scripts/check-dto-load.mjs",
    "test": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js",
    "migration:create": "typeorm migration:create",
    "migration:run": "pnpm build && typeorm migration:run -d dist/common/database/config/data-source.js",
    "migration:revert": "typeorm migration:revert -d dist/common/database/config/data-source.js",
    "migration:generate": "typeorm migration:generate -d dist/common/database/config/data-source.js",
    "seed:plans": "ts-node -r tsconfig-paths/register src/scripts/seed-plans.ts",
    "audit:wallet-currency": "ts-node -r tsconfig-paths/register src/scripts/audit-wallet-currency.ts",
    "smoke:wallet": "ts-node -r tsconfig-paths/register src/scripts/wallet-smoke-checklist.ts",
    "sync:bachs-products": "ts-node -r tsconfig-paths/register src/scripts/sync-bachs-products.ts",
    "sync:bachs-products:dist": "node dist/scripts/sync-bachs-products.js",
    "sync:bachs-wallet-products": "ts-node -r tsconfig-paths/register src/scripts/sync-bachs-wallet-products.ts",
    "sync:billing-products": "ts-node -r tsconfig-paths/register src/scripts/sync-billing-products.ts",
    "provision:tenant-domains": "ts-node -r tsconfig-paths/register src/scripts/provision-tenant-domains.ts",
    "provision:tenant-domains:dist": "node dist/scripts/provision-tenant-domains.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1171.0",
    "@aws-sdk/s3-request-presigner": "^3.1171.0",
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/event-emitter": "^12.0.3",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/passport": "^12.0.2",
    "@nestjs/platform-express": "^12.5.1",
    "@nestjs/schedule": "^12.0.4",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/typeorm": "^12.0.3",
    "@sentry/nestjs": "^11.14.0",
    "@sentry/node": "^11.14.0",
    "@slack/web-api": "^8.4.0",
    "@types/express": "^5.0.6",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-holidays": "^3.39.2",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "fast-geoip": "^1.1.88",
    "helmet": "^8.3.0",
    "helmet-csp": "^4.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.23.1",
    "posthog-node": "^6.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.3",
    "typeorm-naming-strategies": "^4.1.0",
    "zeptomail": "^8.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "latest",
    "@nestjs/cli": "^12.0.13",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.5.1",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.22",
    "@types/cookie-parser": "^1.4.10",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.6",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.7",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-morph": "^28.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "jest": {
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "coverageThreshold": {
      "global": {
        "branches": 0,
        "functions": 0,
        "lines": 0,
        "statements": 0
      },
      "./src/modules/v1/subscriptions/**/*.ts": {
        "branches": 15,
        "functions": 20,
        "lines": 25,
        "statements": 25
      },
      "./src/modules/v1/payroll/**/*.ts": {
        "branches": 15,
        "functions": 20,
        "lines": 25,
        "statements": 25
      }
    },
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    },
    "rootDir": "src",
    "setupFiles": [
      "<rootDir>/../test/jest-setup.ts"
    ],
    "testEnvironment": "node",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
