# --- Core ---
DATABASE_URL=postgresql://username:password@localhost:5432/paqadhr
# Optional — enables distributed rate limits and OTP lockout across API replicas
# REDIS_URL=redis://localhost:6379
NODE_ENV=development
PORT=9001
BASE_URL=http://localhost:9001
FRONTEND_URL=http://localhost:3000
APP_DOMAIN=paqadhr.com
APP_USE_SUBDOMAIN=false
# CORS / CSRF (canonical; ALLOWED_ORIGINS and CORS_ALLOWED_ORIGINS still work)
# Apex origins only; tenant subdomains (https://*.paqadhr.com) are allowed in code when APP_USE_SUBDOMAIN=true
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Auth (JWT) ---
ACCESS_SECRET=your-super-secure-access-secret-here-64-chars-long
REFRESH_SECRET=your-super-secure-refresh-secret-here-64-chars-long
ACCESS_EXPIRES_IN=900000
REFRESH_EXPIRES_IN=604800000
ENCRYPTION_KEY=your-32-character-encryption-key-here

# --- Routing / guards ---
# EXCLUDED_SUBDOMAINS is also accepted as fallback
TENANT_EXCLUDED_SUBDOMAINS=www,api,admin,app,mail,ftp,blog,help,support,cdn,static,portal,setting,panel
EXCLUDED_TENANT_CHECK=/api/v1/users,/api/v1/integrations/oauth,/dashboard/integrations
PUBLIC_ROUTES=/health,/metrics,/api/v1/auth,/api/v1/invite,/csrf/token,/webhook,/api/v1/webhooks,/api/v1/subscriptions/webhooks,/api/v1/payroll/webhooks,/api/v1/tenant-members/roles

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:9001/api/v1/auth/google/callback

# Google Calendar API key for public holiday calendars (optional — falls back to date-holidays)
# Enable Calendar API in Google Cloud Console: https://developers.google.com/workspace/calendar/api/guides/overview
# GOOGLE_CALENDAR_API_KEY=

# --- Slack (OAuth; register Event/Interactivity/Slash URLs under /api/v1/webhooks/slack/*) ---
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_SIGNING_SECRET=your-slack-signing-secret

# --- Email (required in production) ---
ZEPTOMAIL_API_KEY=Zoho-enczapikey your-zeptomail-api-key
# Optional; defaults to https://api.zeptomail.com/v1.1/email
# ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
# Must use a sender address on a domain verified in your ZeptoMail Agent (Mail Agent → SMTP/API)
DEFAULT_FROM_EMAIL=noreply@yourcompany.com
# Logo in transactional emails (defaults to https://paqadhr.com/logo-lockup-light.png)
# EMAIL_LOGO_URL=https://paqadhr.com/logo-lockup-light.png
# Optional: reply-to for founder welcome email (defaults to daniel@paqadhr.com)
# FOUNDER_REPLY_EMAIL=daniel@paqadhr.com

# --- Cloudflare R2 (file uploads — required) ---
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET_NAME=your-bucket-name
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_PUBLIC_ID=your-public-id
R2_CUSTOM_DOMAIN=cdn.yourdomain.com

# --- Cloudflare Turnstile (public careers apply — optional in dev) ---
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# --- Payroll (Nomba payouts when Nomba credentials are configured) ---
# Global Payout authorization PIN from Nomba (one value for USD/EUR/GBP/etc — not per currency).
# Optional. When unset, payroll payouts are NGN-only (local bank transfers).
# Enable Global Payout on your Nomba account, then set the payout PIN Nomba gives you.
NOMBA_PAYOUT_AUTH_CODE=

# --- Billing / subscriptions (Nomba default; Bachs/Polar/Monnify opt-in) ---
# Country → provider: NG uses BILLING_NG_PROVIDER; everyone else uses BILLING_GLOBAL_PROVIDER.
# Local Bachs + Polar setup:
#   1. Set tokens below and pick providers (e.g. BILLING_NG_PROVIDER=bachs, BILLING_GLOBAL_PROVIDER=polar)
#   2. Seed plans if needed: pnpm --filter api seed:plans
#   3. Create provider products + write IDs: pnpm --filter api sync:billing-products
#   4. Point provider dashboards (or a tunnel) at:
#        POST /api/v1/webhooks/bachs
#        POST /api/v1/webhooks/polar
#        POST /api/v1/webhooks/nomba
#        POST /api/v1/webhooks/monnify
BILLING_NG_PROVIDER=nomba
BILLING_GLOBAL_PROVIDER=nomba

NOMBA_CLIENT_ID=
NOMBA_CLIENT_SECRET=
NOMBA_PARENT_ACCOUNT_ID=
NOMBA_WEBHOOK_SIGNATURE_KEY=
# Staging/dev: NOMBA_LIVE=false → https://sandbox.nomba.com (use sandbox credentials)
# Production:  NOMBA_LIVE=true  → https://api.nomba.com (use production credentials)
NOMBA_LIVE=false
# Optional override (normally leave unset so NOMBA_LIVE picks the host):
# NOMBA_BASE_URL=https://sandbox.nomba.com

# Bachs — when BILLING_*_PROVIDER=bachs. Product IDs live on plan_prices.
# Run: pnpm --filter api sync:bachs-products  (or sync:billing-products)
BACHS_SECRET_KEY=
BACHS_WEBHOOK_SECRET=
# BACHS_BASE_URL=https://sandbox-api.bachs.io
# Bachs wallet top-up shell products (ad-hoc amount per checkout). Run: pnpm --filter api sync:bachs-wallet-products
BACHS_WALLET_TOPUP_PRODUCT_NGN=
BACHS_WALLET_TOPUP_PRODUCT_USD=

# Polar — when BILLING_GLOBAL_PROVIDER=polar. Product IDs live on plan_prices.
# Run: pnpm --filter api sync:polar-products  (or sync:billing-products)
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=

# --- Noah (non-NG rewards wallet top-up + non-NGN payroll payouts) ---
# Used when tenant country is NOT NG (rewards checkout) and for non-NGN payroll.
# Webhook: POST /api/v1/webhooks/noah
#
# Sandbox: signing required only if your API key was created with a signing public key.
# Single line for Dokploy/Docker — use \n between PEM lines, e.g.:
# NOAH_SIGNING_PRIVATE_KEY=-----BEGIN EC PRIVATE KEY-----\nMIGk...\n-----END EC PRIVATE KEY-----
# NOAH_SIGNING_PRIVATE_KEY=
NOAH_API_KEY=
NOAH_ENVIRONMENT=sandbox
# NOAH_API_BASE_URL=https://api.sandbox.noah.com/v1
# NOAH_PAYOUT_CRYPTO_CURRENCY=USDC

# --- NGN money rails (Nomba ↔ Monnify peers) ---
# Payroll / bank payouts. Values: nomba | monnify (default nomba).
# Separate from BILLING_NG_PROVIDER (subscriptions can stay on Bachs).
NG_PAYROLL_PROVIDER=nomba
# Legacy alias (still read if NG_PAYROLL_PROVIDER unset): NG_PAYMENTS_PROVIDER

# Rewards wallet deposits. Values: bachs | nomba | monnify. Empty → same as NG_PAYROLL_PROVIDER.
# Requires BACHS_WALLET_TOPUP_PRODUCT_NGN when =bachs (see sync:bachs-wallet-products).
# Auto-topup: NGN = Nomba or Monnify (Monnify needs card tokenization enabled on the merchant account);
# USD = Noah. Bachs wallet deposits are checkout-only (no saved-card auto-topup).
NG_REWARDS_DEPOSIT_PROVIDER=
# NG_REWARDS_DEPOSIT_PROVIDER=bachs
# Legacy alias: NG_WALLET_PAYMENTS_PROVIDER

# Rewards airtime / data / utility. Values: nomba | monnify (default nomba).
# Frontend may still send NOMBA_AIRTIME; backend routes by this env.
NG_REWARDS_AIRTIME_PROVIDER=nomba

# Monnify (required when BILLING_NG_PROVIDER=monnify and/or NG_PAYROLL_PROVIDER / NG_REWARDS_AIRTIME_PROVIDER=monnify)
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_WALLET_ACCOUNT_NUMBER=
MONNIFY_WEBHOOK_SECRET=
MONNIFY_LIVE=false
# Optional override (normally leave unset so MONNIFY_LIVE picks the host):
# MONNIFY_BASE_URL=https://sandbox.monnify.com

# --- Reloadly (gift cards / airtime catalog) ---
RELOADLY_CLIENT_ID=
RELOADLY_CLIENT_SECRET=
RELOADLY_SANDBOX=true
RELOADLY_WEBHOOK_SECRET=
# RELOADLY_BASE_URL=https://giftcards.reloadly.com
# RELOADLY_AUTH_URL=https://auth.reloadly.com/oauth/token

# --- Gift card provider (platform-wide; not per-tenant) ---
# tremendous | reloadly — default tremendous
REWARDS_GIFT_CARD_PROVIDER=tremendous

# --- Tremendous (default gift-card catalog / orders) ---
TREMENDOUS_API_KEY=
TREMENDOUS_FUNDING_SOURCE_ID=
TREMENDOUS_SANDBOX=true
# TREMENDOUS_BASE_URL=https://api.tremendous.com/api/v2
