# Local dev database: `docker compose up -d db` (see docker-compose.yml at repo root)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/paqadhr
NODE_ENV=development
PORT=9001
BASE_URL=http://localhost:9001
FRONTEND_URL=http://localhost:3000
APP_DOMAIN=paqadhr.com
COOKIE_CROSS_SITE=false
# Namespaces auth cookie names per deployment so prod and dev can share one browser.
# Unset → `dev_` outside production (e.g. `dev_access_token`), no prefix in production.
# Set explicitly (e.g. `dev_`) to control the namespace.
COOKIE_NAME_PREFIX=
APP_USE_SUBDOMAIN=false
# Set true when the API is behind Cloudflare/nginx that sets client IP headers
TRUST_PROXY_HEADERS=true
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001
PRIVACY_POLICY_VERSION=1.0
# Set false in local/dev to suppress the privacy re-consent dialog
PRIVACY_RECONSENT_ENABLED=true
ACCESS_SECRET=your-super-secure-access-secret-here-64-chars-long
REFRESH_SECRET=your-super-secure-refresh-secret-here-64-chars-long
# Access token TTL (duration) — max 15m per SECURITY.md §1 (e.g., 15m, 900s, 900000)
ACCESS_EXPIRES_IN=15m
# Refresh JWT + refresh_token cookie TTL (unit suffix required: s|m|h|d).
REFRESH_EXPIRES_IN=7d
# DB session row TTL — must be >= REFRESH_EXPIRES_IN (defaults to refresh when unset).
SESSION_EXPIRES_IN=7d
# Max auth requests per window for login/OTP limiters (positive integer).
AUTH_RATE_LIMIT_MAX=5
ENCRYPTION_KEY=your-32-character-encryption-key-here
TENANT_EXCLUDED_SUBDOMAINS=www,api,admin,app,mail,ftp,blog,help,support,cdn,static,portal,setting,panel
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:9001/api/v1/auth/google/callback
GOOGLE_CALENDAR_API_KEY=
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_SIGNING_SECRET=your-slack-signing-secret
ZEPTOMAIL_API_KEY=Zoho-enczapikey your-zeptomail-api-key
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
DEFAULT_FROM_EMAIL=noreply@yourcompany.com
EMAIL_LOGO_URL=https://pub-aa92a7d639fd40aab9505685d7e75215.r2.dev/logo-lockup-light.png
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET_NAME=your-bucket-name
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_PUBLIC_ID=your-public-id
R2_CUSTOM_DOMAIN=cdn.yourdomain.com
# --- Cloudflare Worker domains (tenant subdomains) ---
# Every workspace gets `<slug>.<CF_WORKER_DOMAIN_SUFFIX>` attached to the web Worker as a
# Cloudflare custom domain, so https://acme.paqadhr.com serves the app. Needed because the
# `*.paqadhr.com` Worker route is taken by the API origin. Leave unset in dev — the
# `*.dev.paqadhr.com` route already covers dev tenants. See docs/cloudflare-web-deploy.md.
# Token scope: Workers Scripts:Edit (Workers Domains) + Zone:Read on the app zone.
CF_WORKER_DOMAIN_API_TOKEN=your-cloudflare-api-token
CF_WORKER_DOMAIN_ZONE_ID=your-cloudflare-zone-id
CF_WORKER_DOMAIN_WORKER_NAME=paqadhr
# Optional — defaults to R2_ACCOUNT_ID and APP_DOMAIN respectively.
# CF_WORKER_DOMAIN_ACCOUNT_ID=your-cloudflare-account-id
# CF_WORKER_DOMAIN_SUFFIX=paqadhr.com
# Set to false to keep the credentials but stop provisioning subdomains.
# CF_WORKER_DOMAIN_ENABLED=true
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
# Must be paired with apps/web NEXT_PUBLIC_TURNSTILE_SITE_KEY — both set or both unset
# Server-only Web3Forms key for the public contact form (never expose to the browser)
WEB3FORMS_ACCESS_KEY=your-web3forms-access-key

# --- Billing ---
BILLING_NG_PROVIDER=bachs
BILLING_GLOBAL_PROVIDER=bachs

# --- Payment provider routing ---
# Bridge payroll/wallet integration. Capabilities default to none; enable an exact
# operation/currency/country/network tuple only after it is confirmed for the account.
BRIDGE_API_KEY=
BRIDGE_BASE_URL=https://api.bridge.xyz
BRIDGE_WEBHOOK_PUBLIC_KEY=
BRIDGE_PAYROLL_CAPABILITIES=[]
# Set true only after Bridge configures PaqadHR's developer-fee settlement account.
BRIDGE_DEVELOPER_FEE_COLLECTION_ENABLED=false
# Each wallet-transfer tuple needs the Bridge asset and network mapping enabled for this account. Example only:
# BRIDGE_PAYROLL_CAPABILITIES='[{"operation":"wallet_transfer","sourceCurrency":"USDC","currency":"USDC","country":"US","network":"SOL","bridgeCurrency":"usdc","bridgePaymentRail":"solana"},{"operation":"wallet_creation","sourceCurrency":"USDC","currency":"USDC","country":"US","network":"SOL","bridgeChain":"solana"}]'
BRIDGE_REQUEST_TIMEOUT_MS=15000

# Rewards wallet checkout deposits are configured separately from payroll routing.
NG_REWARDS_DEPOSIT_PROVIDER=nomba
# Non-NGN rewards wallet checkout: noah | fincra
INTL_REWARDS_DEPOSIT_PROVIDER=noah
# Airtime/utilities (NG only): nomba | monnify
NG_REWARDS_AIRTIME_PROVIDER=nomba

# --- Nomba ---
NOMBA_CLIENT_ID=
NOMBA_CLIENT_SECRET=
NOMBA_PARENT_ACCOUNT_ID=
# Optional Nomba sub-account ID used to scope NGN payroll settlement.
NOMBA_SUB_ACCOUNT_ID=
NOMBA_WEBHOOK_SIGNATURE_KEY=
NOMBA_LIVE=false
NOMBA_BASE_URL=https://sandbox.nomba.com
# Payroll routing is exact: NGN uses Nomba only when explicitly enabled; other currencies use Bridge.
NOMBA_PAYROLL_NGN_ENABLED=false
# PaqadHR markup per employee transfer, added on top of Nomba's payout fee reserve.
PAYROLL_NOMBA_TRANSFER_CHARGE_NGN=50
# Required before enabling Nomba payroll: set the exact account-confirmed bank-transfer fee per payout.
PAYROLL_PAYOUT_FEE_NOMBA_NGN=

# --- Monnify ---
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_WALLET_ACCOUNT_NUMBER=
MONNIFY_WEBHOOK_SECRET=
MONNIFY_LIVE=false
# MONNIFY_BASE_URL=https://sandbox.monnify.com

# --- Bachs (subscriptions; also retained for existing wallet checkout flows) ---
BACHS_SECRET_KEY=
BACHS_WEBHOOK_SECRET=
BACHS_BASE_URL=https://sandbox-api.bachs.io
BACHS_WALLET_TOPUP_PRODUCT_NGN=
BACHS_WALLET_TOPUP_PRODUCT_USD=

# --- Noah ---
NOAH_API_KEY=
NOAH_SIGNING_PRIVATE_KEY=-----BEGIN EC PRIVATE KEY-----\nMIGk...\n-----END EC PRIVATE KEY-----
NOAH_ENVIRONMENT=sandbox
NOAH_API_BASE_URL=https://api.sandbox.noah.com/v1
NOAH_PAYOUT_CRYPTO_CURRENCY=USDC
# Optional override for webhook signature verification.
# NOAH_WEBHOOK_PUBLIC_KEY=

# --- Fincra ---
FINCRA_API_KEY=
FINCRA_PUBLIC_KEY=
FINCRA_WEBHOOK_SECRET=
FINCRA_LIVE=false
FINCRA_BUSINESS_ID=
# Optional override restricted to Fincra API hosts.
# FINCRA_BASE_URL=https://sandboxapi.fincra.com
# Optional account-specific settings for supported Fincra reward operations.
# FINCRA_PAYOUT_SOURCE_CURRENCY=
# FINCRA_PAYOUT_DOCUMENT_URL=

REWARDS_GIFT_CARD_PROVIDER=tremendous
TREMENDOUS_API_KEY=
TREMENDOUS_FUNDING_SOURCE_ID=
TREMENDOUS_SANDBOX=true
TREMENDOUS_BASE_URL=https://api.tremendous.com/api/v2
TREMENDOUS_WEBHOOK_SECRET=

# --- Observability ---
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=
# Required when PostHog is enabled. Keep private and rotate if exposed.
POSTHOG_IDENTIFIER_SALT=

# Recruitment AI (Mastra agents). Leave unset to disable AI features.
ANTHROPIC_API_KEY=
# RECRUITMENT_AI_MODEL=claude-sonnet-5-5
