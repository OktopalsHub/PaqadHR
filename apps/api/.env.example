DATABASE_URL=postgresql://username:password@localhost:5432/paqadhr
NODE_ENV=development
PORT=9001
BASE_URL=http://localhost:9001
FRONTEND_URL=http://localhost:3000
APP_DOMAIN=paqadhr.com
COOKIE_CROSS_SITE=false
APP_USE_SUBDOMAIN=false
# Set true when the API is behind Cloudflare/nginx that sets client IP headers
TRUST_PROXY_HEADERS=true
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001
PRIVACY_POLICY_VERSION=1.0
# Set false in local/dev to suppress the privacy re-consent dialog
PRIVACY_RECONSENT_ENABLED=true
ACCESS_SECRET=your-super-secure-access-secret-here-64-chars-long
REFRESH_SECRET=your-super-secure-refresh-secret-here-64-chars-long
# Access token TTL (duration) — max 15m per SECURITY.md §1 (e.g., 15m, 900s, 900000)
ACCESS_EXPIRES_IN=15m
# Refresh token TTL — auth.service defaults: 30d (rememberMe) / 24h (otherwise). Env overrides if set.
REFRESH_EXPIRES_IN=2592000000
# Alternative durations: 30d=2592000000ms, 7d=604800000ms
ENCRYPTION_KEY=your-32-character-encryption-key-here
TENANT_EXCLUDED_SUBDOMAINS=www,api,admin,app,mail,ftp,blog,help,support,cdn,static,portal,setting,panel
EXCLUDED_TENANT_CHECK=/api/v1/users,/api/v1/integrations/oauth,/dashboard/integrations
PUBLIC_ROUTES=/health,/metrics,/api/v1/auth,/api/v1/invite,/csrf/token,/webhook,/api/v1/webhooks,/api/v1/subscriptions/webhooks,/api/v1/payroll/webhooks,/api/v1/tenant-members/roles
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:9001/api/v1/auth/google/callback
GOOGLE_CALENDAR_API_KEY=
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_SIGNING_SECRET=your-slack-signing-secret
ZEPTOMAIL_API_KEY=Zoho-enczapikey your-zeptomail-api-key
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
DEFAULT_FROM_EMAIL=noreply@yourcompany.com
EMAIL_LOGO_URL=https://paqadhr.com/logo-lockup-light.png
FOUNDER_REPLY_EMAIL=daniel@paqadhr.com
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET_NAME=your-bucket-name
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_PUBLIC_ID=your-public-id
R2_CUSTOM_DOMAIN=cdn.yourdomain.com
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
# Must be paired with apps/web NEXT_PUBLIC_TURNSTILE_SITE_KEY — both set or both unset
# Server-only Web3Forms key for the public contact form (never expose to the browser)
WEB3FORMS_ACCESS_KEY=your-web3forms-access-key

# --- Billing ---
BILLING_NG_PROVIDER=nomba
BILLING_GLOBAL_PROVIDER=nomba
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=

# --- Payment provider routing ---
# NGN payroll: nomba | monnify | fincra
NG_PAYROLL_PROVIDER=nomba
# International payroll + stablecoin payouts: noah | fincra
INTL_PAYROLL_PROVIDER=noah
# Rewards wallet checkout deposits (empty → same as NG_PAYROLL_PROVIDER)
NG_REWARDS_DEPOSIT_PROVIDER=
# Non-NGN rewards wallet checkout: noah | fincra
INTL_REWARDS_DEPOSIT_PROVIDER=noah
# Airtime/utilities (NG only): nomba | monnify
NG_REWARDS_AIRTIME_PROVIDER=nomba

# --- Nomba ---
NOMBA_CLIENT_ID=
NOMBA_CLIENT_SECRET=
NOMBA_PARENT_ACCOUNT_ID=
NOMBA_PAYOUT_AUTH_CODE=
NOMBA_WEBHOOK_SIGNATURE_KEY=
NOMBA_LIVE=false
NOMBA_BASE_URL=https://sandbox.nomba.com

# --- Monnify ---
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_WALLET_ACCOUNT_NUMBER=
MONNIFY_WEBHOOK_SECRET=
MONNIFY_LIVE=false
# MONNIFY_BASE_URL=https://sandbox.monnify.com

# --- Bachs (wallet checkout; run sync:bachs-wallet-products after deploy) ---
BACHS_SECRET_KEY=
BACHS_WEBHOOK_SECRET=
BACHS_BASE_URL=https://sandbox-api.bachs.io
BACHS_WALLET_TOPUP_PRODUCT_NGN=
BACHS_WALLET_TOPUP_PRODUCT_USD=

# --- Noah ---
NOAH_API_KEY=
NOAH_SIGNING_PRIVATE_KEY=-----BEGIN EC PRIVATE KEY-----\nMIGk...\n-----END EC PRIVATE KEY-----
NOAH_ENVIRONMENT=sandbox
NOAH_API_BASE_URL=https://api.sandbox.noah.com/v1
NOAH_PAYOUT_CRYPTO_CURRENCY=USDC

# --- Fincra ---
FINCRA_API_KEY=
FINCRA_PUBLIC_KEY=
FINCRA_WEBHOOK_SECRET=
FINCRA_LIVE=false

# --- Reloadly (gift cards / airtime catalog) ---
RELOADLY_CLIENT_ID=
RELOADLY_CLIENT_SECRET=
RELOADLY_SANDBOX=true
RELOADLY_WEBHOOK_SECRET=
RELOADLY_BASE_URL=https://giftcards.reloadly.com
RELOADLY_AUTH_URL=https://auth.reloadly.com/oauth/token
REWARDS_GIFT_CARD_PROVIDER=tremendous
TREMENDOUS_API_KEY=
TREMENDOUS_FUNDING_SOURCE_ID=
TREMENDOUS_SANDBOX=true
TREMENDOUS_BASE_URL=https://api.tremendous.com/api/v2

# --- Observability ---
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=
# Required when PostHog is enabled. Keep private and rotate if exposed.
POSTHOG_IDENTIFIER_SALT=
