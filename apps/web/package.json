  "scripts": {
    "dev": "next dev --webpack",
    "dev:clean": "rm -rf .next .turbo && next dev --webpack",
    "clean": "rm -rf .next .turbo",
    "typecheck:tests": "tsc --noEmit --pretty false -p tsconfig.test.json",
    "build": "pnpm run typecheck:tests && next build --webpack",
    "test": "tsx --test features/activity/lib/activity-format.test.ts features/attendance/lib/attendance-feature-access.test.ts features/auth/lib/submit-handled-auth-action.test.ts features/dashboard/lib/dashboard-feature-access.test.ts features/home/lib/landing-pricing-currency.test.ts features/leaves/lib/leave-assignment-panel-state.test.ts features/onboarding/lib/onboarding-step.test.ts features/recruitment/hooks/recruitment-overview-query-options.test.ts features/recruitment/hooks/use-recruitment-overview.test.ts features/recruitment/lib/filter-recruitment-jobs.test.ts features/settings/lib/settings-tabs.test.ts features/settings/lib/workspace-payroll-currencies.test.ts features/shoutouts/lib/shoutouts-rewards-access.test.ts lib/shoutouts/shoutout-message-tokens.test.ts hooks/queries/use-calendar.test.ts hooks/queries/use-feature-access.test.ts lib/api/api-request-headers.test.ts lib/api/client-error-message.test.ts lib/api/fetch-with-csrf.test.ts lib/constants/feature-access-resolver.test.ts lib/constants/route-feature-map.test.ts lib/mappers/employee.test.ts lib/security/content-security-policy.test.ts providers/breadcrumb-tail-state.test.ts",
    "start": "next start",
    "lint": "biome check .",
    "check": "biome check . && pnpm run typecheck:tests",
    "format": "biome check --write .",
    "cf:build": "opennextjs-cloudflare build",
    "cf:deploy": "node scripts/cf-deploy.mjs",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-deploy": "opennextjs-cloudflare deploy",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
