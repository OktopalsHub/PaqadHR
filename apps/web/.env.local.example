# Reference only — not loaded by the app. Copy keys/values into apps/web/.env

# Local development
NEXT_PUBLIC_API_URL=http://localhost:9001
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
NEXT_PUBLIC_APP_DOMAIN=paqadhr.com
NEXT_PUBLIC_USE_SUBDOMAIN_TENANTS=false

# Optional: custom R2 public origin for workspace logos (e.g. https://pub-xxx.r2.dev)
NEXT_PUBLIC_R2_PUBLIC_URL=

# Cloudflare Workers Builds (required for CSP connect-src and API client)
# dev worker (dev.paqadhr.com):
#   NEXT_PUBLIC_API_URL=https://api-dev.paqadhr.com
# production worker (paqadhr.com):
#   NEXT_PUBLIC_API_URL=https://prod.paqadhr.com
# If unset at build time, middleware falls back by hostname (dev.paqadhr.com → api-dev).
# Subdomain tenants: set NEXT_PUBLIC_USE_SUBDOMAIN_TENANTS=true and use /etc/hosts
# entries like 127.0.0.1 acme.localhost for local testing.

# Cloudflare deploy config (read by scripts/cf-deploy.mjs — see
# docs/cloudflare-web-deploy.md). Set these per Workers Build so the dev,
# main and production Workers deploy from this repo without code changes.
#   CF_WORKER_NAME=paqadhr-dev          # optional; defaults to paqadhr on main,
#                                        # paqadhr-dev on dev/previews
#   CF_COMPAT_DATE=2026-07-01           # optional, defaults to the repo pin
#   CF_WORKERS_DEV=false                # optional, publish on workers.dev too
#   CF_ROUTES=[{"pattern":"dev.paqadhr.com","custom_domain":true}]
#     optional JSON array of routes/custom domains; empty means "no routes"
#     (attach custom domains in the dashboard instead when you prefer that)
#   NEXT_PUBLIC_API_URL / NEXT_PUBLIC_APP_URL / NEXT_PUBLIC_APP_DOMAIN /
#   NEXT_PUBLIC_USE_SUBDOMAIN_TENANTS
#     baked into the build and set as Worker vars; values already configured
#     on the Worker in the dashboard win (deploys run with --keep-vars)

# Observability (optional — no-op when unset). See docs/observability.md
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
