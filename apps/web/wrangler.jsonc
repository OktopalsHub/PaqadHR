{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Local-dev baseline only. `pnpm cf:deploy` deploys a config resolved from
  // the environment (scripts/cf-config.mjs) and passes it via --config, so
  // worker name, vars, routes and compatibility date live in the build
  // environment, not here. See docs/cloudflare-web-deploy.md.
  "main": ".open-next/worker.js",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "keep_names": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {},
  "routes": []
}
