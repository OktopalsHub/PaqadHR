# Local development
NEXT_PUBLIC_API_URL=http://localhost:9001
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Optional: custom R2 public origin for workspace logos (e.g. https://pub-xxx.r2.dev)
NEXT_PUBLIC_R2_PUBLIC_URL=

# Cloudflare Workers Builds (required for CSP connect-src and API client)
# dev worker (dev.paqadhr.com):
#   NEXT_PUBLIC_API_URL=https://api-dev.paqadhr.com
# production worker (paqadhr.com):
#   NEXT_PUBLIC_API_URL=https://api.paqadhr.com
# If unset at build time, middleware falls back by hostname (dev.paqadhr.com → api-dev).
