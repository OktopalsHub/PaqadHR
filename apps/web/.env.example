# Copy to .env.local for local development. Fill in the values for your environment.
# Cloudflare Workers Builds must define these as build variables for each branch.
CF_WORKER_NAME=
CF_COMPAT_DATE=
CF_ROUTES=
CF_WORKERS_DEV=false

NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_APP_DOMAIN=
NEXT_PUBLIC_USE_SUBDOMAIN_TENANTS=

# Unique per deploy; must match public/version.json for silent reload after deploys
NEXT_PUBLIC_APP_BUILD_ID=
# Pair with apps/api TURNSTILE_SECRET_KEY — both set or both unset
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_R2_PUBLIC_URL=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
