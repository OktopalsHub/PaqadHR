{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["apps/api/**", "apps/web/**"]
  },
  "formatter": {
    "enabled": false
  },
  "javascript": {},
  "assist": {
    "enabled": false
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "warn",
        "useExhaustiveDependencies": "warn"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noArrayIndexKey": "warn",
        "noImplicitAnyLet": "warn"
      },
      "style": {
        "noNonNullAssertion": "off"
      },
      "complexity": {
        "useMathMinMax": "off"
      },
      "a11y": {
        "noSvgWithoutTitle": "off",
        "useSemanticElements": "warn",
        "useFocusableInteractive": "warn",
        "useValidAnchor": "warn",
        "useAriaPropsForRole": "warn",
        "noRedundantRoles": "warn",
        "noNoninteractiveElementToInteractiveRole": "warn"
      },
      "security": {
        "noDangerouslySetInnerHtml": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/eslint.config.mjs"],
      "linter": {
        "enabled": false
      }
    },
    {
      "includes": ["apps/api/**"],
      "javascript": {
        "parser": {
          "unsafeParameterDecoratorsEnabled": true
        }
      },
      "linter": {
        "rules": {
          "style": {
            "useImportType": "off"
          },
          "complexity": {
            "noStaticOnlyClass": "off"
          },
          "correctness": {
            "noUnusedFunctionParameters": "off",
            "noUnusedPrivateClassMembers": "warn"
          }
        }
      }
    },
    {
      "includes": ["apps/web/components/ui/**", "apps/web/components/reui/**"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "useFocusableInteractive": "off",
            "useAriaPropsForRole": "off",
            "useKeyWithClickEvents": "off",
            "useKeyWithMouseEvents": "off",
            "noNoninteractiveTabindex": "off",
            "noNoninteractiveElementInteractions": "off",
            "noStaticElementInteractions": "off",
            "useValidAnchor": "off"
          },
          "security": {
            "noDangerouslySetInnerHtml": "off"
          },
          "suspicious": {
            "noDocumentCookie": "off",
            "noArrayIndexKey": "off",
            "noAssignInExpressions": "off"
          },
          "correctness": {
            "useExhaustiveDependencies": "off",
            "noUnusedFunctionParameters": "off",
            "noComponentHookFactories": "off"
          },
          "complexity": {
            "noUselessFragments": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/public/**"],
      "linter": {
        "enabled": false
      }
    },
    {
      "includes": ["apps/web/**/*.generated.ts"],
      "linter": {
        "enabled": false
      }
    },
    {
      "includes": ["apps/web/**/*.test.ts", "apps/web/**/*.test.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            "noComponentHookFactories": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/api/test/**", "apps/api/**/*.spec.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    }
  ]
}
