{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "sortImports": true,
  "ignorePatterns": [
    "**/*.md",
    "**/*.mdx",
    "**/*.yml",
    "**/*.yaml",
    "pnpm-lock.yaml",
    "apps/web/public/**",
    "apps/web/**/*.generated.ts",
    "apps/web/content/**",
    "**/eslint.config.mjs",
    "**/.next/**",
    "**/.open-next/**",
    "**/dist/**"
  ]
}
